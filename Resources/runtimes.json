{
  "schemaVersion": 5,
  "wine": {
    "name": "Wine Staging (Gcenx macOS build)",
    "version": "11.21",
    "url": "https://github.com/Gcenx/macOS_Wine_builds/releases/download/11.21/wine-staging-11.21-osx64.tar.xz",
    "sha256": "d7bcd5abf4df27aae397a7898aef074fea4a2e0b51e0a55aa9659517bbf9d452",
    "archiveRoot": "Wine Staging.app",
    "binDirectory": "Contents/Resources/wine/bin",
    "libDirectory": "Contents/Resources/wine/lib",
    "supportsESync": false,
    "supportsMSync": false
  },
  "steam": {
    "installerURL": "https://cdn.akamai.steamstatic.com/client/installer/SteamSetup.exe",
    "installerArguments": [
      "/S"
    ],
    "executablePath": "Program Files (x86)/Steam/steam.exe",
    "defaultArguments": [
      "-cef-disable-gpu",
      "-cef-disable-gpu-compositing"
    ],
    "argumentPresets": [
      {
        "name": "Oberfläche ohne Grafikbeschleunigung (Standard)",
        "arguments": [
          "-cef-disable-gpu",
          "-cef-disable-gpu-compositing"
        ]
      },
      {
        "name": "Wie Standard, zusätzlich ohne Sandbox",
        "arguments": [
          "-cef-disable-gpu",
          "-cef-disable-gpu-compositing",
          "-no-cef-sandbox",
          "-cef-disable-gpu-sandbox"
        ]
      },
      {
        "name": "Oberfläche mit Grafikbeschleunigung",
        "arguments": []
      }
    ],
    "uiFix": {
      "enabled": true,
      "library": "steam-ui-fix/winmm.dll",
      "builtinLibrary": "wine/x86_64-windows/winmm.dll",
      "browserArguments": [
        "--in-process-gpu"
      ]
    }
  }
}
