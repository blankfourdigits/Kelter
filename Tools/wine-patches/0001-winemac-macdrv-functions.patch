winemac.drv: export a macdrv_functions table for DXMT and D3DMetal.

DXMT (Direct3D 10/11 over Metal) and Apple's D3DMetal look up
dlsym(RTLD_DEFAULT, "macdrv_functions"), as offered by CrossOver's Wine, to
create a Metal view in a window. Upstream winemac.so exports no such symbol,
so DXMT fails with "Failed to create metal view, it seems like your Wine has
no exported symbols needed by DXMT".

- window.c: export the table in the layout these layers expect. Their
  struct macdrv_win_data has client_cocoa_view as fourth field, Wine 11's
  struct differs, so get_win_data hands out a copy in that layout. The copy
  holds no lock and is never NULL (callers do not check); without a client
  surface view the window's content view hosts the Metal view.
  macdrv_init_display_devices is a no-op: D3DMetal calls it, and Wine 11
  keeps display devices up to date in win32u.
- cocoa_window.m: count users of the cached WineMetalView so a second swap
  chain for the same window does not over-release it.

For Wine 11.21 with Wine Staging 11.21 applied. LGPL-2.1-or-later like Wine.
Based on NNikolaG/bridgewine patches 0006 and 0007 and on
codeWonderland/neutron tools/wine-dxmt/winemac-dxmt.patch (both MIT), and on
the interface of CrossOver's winemac.drv (CW-Hack 22435).

diff --git a/dlls/winemac.drv/cocoa_window.m b/dlls/winemac.drv/cocoa_window.m
index 1ec3729..094109a 100644
--- a/dlls/winemac.drv/cocoa_window.m
+++ b/dlls/winemac.drv/cocoa_window.m
@@ -217,6 +217,8 @@ @interface WineBaseView : NSView
 @interface WineMetalView : WineBaseView
 {
     id<MTLDevice> _device;
+@public
+    NSUInteger _users; /* callers of macdrv_view_create_metal_view() not yet released */
 }
 
     - (id) initWithFrame:(NSRect)frame device:(id<MTLDevice>)device;
@@ -558,13 +560,20 @@ - (void) wine_setBackingSize:(const int*)newBackingSize
 
     - (WineMetalView*) newMetalViewWithDevice:(id<MTLDevice>)device
     {
-        if (_metalView) return _metalView;
+        if (_metalView)
+        {
+            /* "new" hands out a reference; a second swap chain for the same
+               window must not share the first one's. */
+            _metalView->_users++;
+            return [_metalView retain];
+        }
 
         WineMetalView* view = [[WineMetalView alloc] initWithFrame:[self bounds] device:device];
         [view setAutoresizingMask:NSViewWidthSizable | NSViewHeightSizable];
         [self setAutoresizesSubviews:YES];
         [self addSubview:view positioned:NSWindowBelow relativeTo:nil];
         _metalView = view;
+        _metalView->_users = 1;
 
         [(WineWindow*)self.window windowDidDrawContent];
 
@@ -3632,11 +3641,42 @@ void macdrv_release_metal_device(id<MTLDevice> device)
 void macdrv_view_release_metal_view(WineMetalView *view)
 {
     OnMainThread(^{
-        [view removeFromSuperview];
+        /* keep the view on screen while another caller still uses it */
+        if (!view->_users || !--view->_users) [view removeFromSuperview];
         [view release];
     });
 }
 
+
+/***********************************************************************
+ *              macdrv_get_window_content_view
+ *
+ * The window's content view, to host Metal views of external D3D layers
+ * when the window has no client surface view.
+ */
+WineContentView *macdrv_get_window_content_view(WineWindow *window)
+{
+    __block WineContentView *view = nil;
+
+    if (!window) return nil;
+    OnMainThread(^{
+        view = [window contentView];
+    });
+    return view;
+}
+
+
+/***********************************************************************
+ *              macdrv_run_on_main_thread
+ *
+ * Runs a block synchronously on the Cocoa main thread, for external D3D
+ * layers.
+ */
+void macdrv_run_on_main_thread(void *block)
+{
+    if (block) OnMainThread((dispatch_block_t)block);
+}
+
 @protocol WineMetalSwapChain <NSObject>
 
 - (CAMetalLayer*) layer;
