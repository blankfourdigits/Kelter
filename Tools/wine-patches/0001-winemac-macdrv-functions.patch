diff --git a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
index 552971f..e72ef74 100644
--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -2208,3 +2208,117 @@ void init_win_context(void)
     pthread_mutex_init(&win_data_mutex, &attr);
     pthread_mutexattr_destroy(&attr);
 }
+
+
+/***********************************************************************
+ *              macdrv_functions
+ *
+ * Exported for external D3D layers (DXMT, D3DMetal), which look the table
+ * up with dlsym(RTLD_DEFAULT, "macdrv_functions") to create a Metal view in
+ * a window, as offered by CrossOver's Wine. Their struct macdrv_win_data
+ * only knows the leading hwnd/cocoa_window/cocoa_view/client_cocoa_view
+ * fields, which do not match this driver's layout, so get_win_data hands
+ * out a copy in that layout. The copy holds no lock, and it is never NULL:
+ * DXMT reads client_cocoa_view without checking the result, so an unknown
+ * window yields a copy without views, for which no Metal view is created.
+ *
+ * Based on patches by NNikolaG/bridgewine and codeWonderland/neutron (MIT)
+ * and on the interface of CrossOver's winemac.drv (CW-Hack 22435).
+ */
+struct macdrv_external_win_data
+{
+    HWND             hwnd;
+    WineWindow      *cocoa_window;
+    WineContentView *cocoa_view;
+    WineContentView *client_cocoa_view;
+};
+
+static struct macdrv_external_win_data *external_get_win_data(HWND hwnd)
+{
+    struct macdrv_external_win_data *ret;
+    struct macdrv_win_data *data;
+    WineContentView *client_view = NULL;
+    WineWindow *cocoa_window = NULL;
+
+    if (!(ret = calloc(1, sizeof(*ret)))) return NULL;
+    ret->hwnd = hwnd;
+
+    if ((data = get_win_data(hwnd)))
+    {
+        cocoa_window = data->cocoa_window;
+        client_view = data->client_view;
+        release_win_data(data);
+    }
+
+    /* without a client surface (no GL/Vulkan yet) host the view in the
+       window's content view; ask Cocoa only after dropping the lock */
+    if (!client_view) client_view = macdrv_get_window_content_view(cocoa_window);
+
+    ret->cocoa_window = cocoa_window;
+    ret->cocoa_view = client_view;
+    ret->client_cocoa_view = client_view;
+    TRACE("hwnd %p window %p view %p\n", hwnd, cocoa_window, client_view);
+    return ret;
+}
+
+/* D3DMetal calls this before creating a swap chain. Wine 11 keeps the
+   display devices up to date in win32u, so there is nothing left to do. */
+static void external_init_display_devices(BOOL force)
+{
+    TRACE("force %d\n", force);
+}
+
+static void external_release_win_data(struct macdrv_external_win_data *data)
+{
+    free(data);
+}
+
+static WineWindow *external_get_cocoa_window(HWND hwnd, BOOL require_on_screen)
+{
+    return macdrv_get_cocoa_window(hwnd, require_on_screen != 0);
+}
+
+static WineMetalView *external_create_metal_view(WineContentView *view, MTLDevice_id device)
+{
+    if (!view || !device) return NULL;
+    return macdrv_view_create_metal_view(view, device);
+}
+
+static CAMetalLayer *external_get_metal_layer(WineMetalView *view)
+{
+    if (!view) return NULL;
+    return macdrv_view_get_metal_layer(view);
+}
+
+static void external_release_metal_view(WineMetalView *view)
+{
+    if (view) macdrv_view_release_metal_view(view);
+}
+
+struct macdrv_external_functions
+{
+    void (*macdrv_init_display_devices)(BOOL);
+    struct macdrv_external_win_data *(*get_win_data)(HWND hwnd);
+    void (*release_win_data)(struct macdrv_external_win_data *data);
+    WineWindow *(*macdrv_get_cocoa_window)(HWND hwnd, BOOL require_on_screen);
+    MTLDevice_id (*macdrv_create_metal_device)(void);
+    void (*macdrv_release_metal_device)(MTLDevice_id device);
+    WineMetalView *(*macdrv_view_create_metal_view)(WineContentView *view, MTLDevice_id device);
+    CAMetalLayer *(*macdrv_view_get_metal_layer)(WineMetalView *view);
+    void (*macdrv_view_release_metal_view)(WineMetalView *view);
+    void (*on_main_thread)(void *block);
+};
+
+__attribute__((visibility("default"))) const struct macdrv_external_functions macdrv_functions =
+{
+    external_init_display_devices,
+    external_get_win_data,
+    external_release_win_data,
+    external_get_cocoa_window,
+    macdrv_create_metal_device,
+    macdrv_release_metal_device,
+    external_create_metal_view,
+    external_get_metal_layer,
+    external_release_metal_view,
+    macdrv_run_on_main_thread,
+};
